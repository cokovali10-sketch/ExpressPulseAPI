{
  "name": "expresspulse-api",
  "version": "2.0.0",
  "description": "Production-grade REST API for real-time system resource monitoring with alerts, rate limiting, and historical metrics",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.1.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.2",
    "typescript": "^5.3.0",
    "ts-node": "^10.9.2",
    "vitest": "^1.1.0",
    "supertest": "^6.3.3"
  },
  "license": "MIT"
}
